# Google AI API Key (required)
# Get from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here
# or
GEMINI_API_KEY=your_gemini_api_key_here

# Instagram Credentials (required)
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# Instagram 2FA Seed (optional - only if you have 2FA enabled)
# Format: Base32 encoded string (e.g., JBSWY3DPEHPK3PXP)
# You get this when setting up 2FA - save the "secret key"
INSTAGRAM_2FA_SEED=your_2fa_seed_here
